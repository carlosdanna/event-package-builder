# Bearer token for the Proposales developer interface (https://api.proposales.com/v3).
# Read only on the server. Never prefix it with NEXT_PUBLIC.
PROPOSALES_API_KEY=

# Optional. The Proposales company to use. When empty, the only company the token can see is used.
PROPOSALES_COMPANY_ID=

# The shared password for signing in to the app. Read only on the server.
# Changing it signs everyone out. When empty, nobody can sign in.
APP_PASSWORD=
